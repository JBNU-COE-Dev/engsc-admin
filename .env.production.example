# 프로덕션 환경 변수 예시
# 실제 배포 시 .env.production 파일을 생성하고 아래 값을 수정하세요

# 백엔드 API Base URL
# 예: IP 기반인 경우
VITE_API_BASE_URL=http://113.198.66.98:8080

# 예: 도메인을 사용하는 경우 (HTTPS 포함 예정)
# VITE_API_BASE_URL=https://api.yourdomain.com

# 관리자 Google 로그인 (engsc-web의 REACT_APP_GOOGLE_CLIENT_ID와 같은 값)
# 비워 두면 로그인 화면에 Google 버튼이 표시되지 않습니다.
VITE_GOOGLE_CLIENT_ID=
